#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer InputPixels { vec4 source[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputPixels { vec4 result[]; };
layout(push_constant) uniform Settings { uint count; float gain; } settings;
void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= settings.count) return;
    // Linear working RGB can be negative or above display white; alpha is preserved.
    vec4 pixel = source[index];
    result[index] = vec4(pixel.rgb * settings.gain, pixel.a);
}
