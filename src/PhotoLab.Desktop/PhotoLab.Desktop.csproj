<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>PhotoLab</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhotoLab.Core/PhotoLab.Core.csproj" />
    <ProjectReference Include="../PhotoLab.Imaging/PhotoLab.Imaging.csproj" />
    <ProjectReference Include="../PhotoLab.Rendering/PhotoLab.Rendering.csproj" />
    <ProjectReference Include="../PhotoLab.Infrastructure/PhotoLab.Infrastructure.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>
</Project>
